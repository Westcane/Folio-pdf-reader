{
  "name": "folio-local-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "vite --host 0.0.0.0 --mode https",
    "api": "node server/index.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:https": "vite preview --host 0.0.0.0 --mode https",
    "test": "vitest run",
    "test:api": "node --test server/deepseek.test.mjs",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/create-fixtures.mjs",
    "check": "npm run test && npm run test:api && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26",
    "dexie": "^4.4.4",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "fake-indexeddb": "^6.2.5",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
